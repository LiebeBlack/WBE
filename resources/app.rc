// ===========================================================================
//  app.rc — Recursos de S.M.A.C Web Core (manifest + icono + versión).
// ===========================================================================
#include <windows.h>

// Manifest: DPI per-monitor v2 + common controls + UTF-8.
1 RT_MANIFEST "app.manifest"

// Icono de la aplicación (resources/smac.ico).
1 ICON "smac.ico"

// ---------------------------------------------------------------------------
// Información de versión (Propiedades -> Detalles del exe).
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"   // Español (España), Unicode
        BEGIN
            VALUE "CompanyName",      "S.M.A.C Project"
            VALUE "FileDescription",  "S.M.A.C Web Core — Navegador minimalista"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "smac-webcore"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "SMAC-WebCore.exe"
            VALUE "ProductName",      "S.M.A.C Web Core"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
